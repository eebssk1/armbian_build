From 5b58a9a90aefffce614f8998cea27a95d090a518 Mon Sep 17 00:00:00 2001
From: Alexandre Frade <kernel@xanmod.org>
Date: Mon, 15 Jul 2024 04:50:34 +0000
Subject: [PATCH 10/18] XANMOD: blk-wbt: Set wbt_default_latency_nsec() to
 2msec

Signed-off-by: Alexandre Frade <kernel@xanmod.org>
---
 block/blk-wbt.c | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/block/blk-wbt.c b/block/blk-wbt.c
index 953d400fd013..90064c2f91d3 100644
--- a/block/blk-wbt.c
+++ b/block/blk-wbt.c
@@ -798,12 +798,7 @@ void wbt_init_enable_default(struct gendisk *disk)
 
 static u64 wbt_default_latency_nsec(struct request_queue *q)
 {
-	/*
-	 * We default to 2msec for non-rotational storage, and 75msec
-	 * for rotational storage.
-	 */
-	if (blk_queue_rot(q))
-		return 75000000ULL;
+	/* XanMod defaults to 2msec for any type of storage */
 	return 2000000ULL;
 }
 
