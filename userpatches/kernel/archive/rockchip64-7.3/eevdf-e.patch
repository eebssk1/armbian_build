+/*
+ * Wakeup-burst penalty: a task that wakes very frequently while using
+ * little CPU (e.g. a hammering yield/futex loop) is pushed back on the
+ * EEVDF lag scale instead of being granted the full sleep benefit.
+ * wakeup_avg is a PELT-decayed wakeup rate: each wakeup adds 1024, the
+ * PELT half-life is 24ms and wakeup_avg = wakeup_sum / divider, so
+ * wakeup_avg ~= sustained wakeup rate in thousands per second.
+ * The threshold punishes ~2k+ wakeups/sec; UTIL_LOW_THRESHOLD keeps
+ * busy tasks (real work) out of the penalty path. Tune via sysctl.
+ */
+#define WAKEUP_PENALTY_THRESHOLD	2
+#define UTIL_LOW_THRESHOLD		76
 
