# configuration values for the armbian-zram-config service
#
# enable the armbian-zram-config service?
ENABLED=true

# Zram swap enabled by default, unless set to disabled
# SWAP=false

# percentage of zram used as swap compared to physically available DRAM.
# Huge overcommitment (300) is possible and sometimes desirable. See
# https://forum.armbian.com/topic/5565-zram-vs-swap/?do=findComment&comment=61082
# The default MEM_LIMIT_PERCENTAGE below follows this value.
# Default by reported RAM: 300% through 640 MiB, 200% through 1280 MiB, 100% through 2560 MiB, 50% above.
# ZRAM_PERCENTAGE=50

# percentage of DRAM available to zram. If this amount is exceeded the zram
# devices used for swap simply behave as if the device is full.
# Default: estimate 3:1 for active zstd, 2.5:1 otherwise. Limit the default to 50-100%.
# MEM_LIMIT_PERCENTAGE=50

# create how many zram devices max for swap
# ZRAM_MAX_DEVICES=4

# Unset, empty or kernel_default: keep the active kernel algorithm.
# auto: request zstd through 2560 MiB, then lzo (prefer lzo-rle if available).
# An explicit name selects an exact match. If lzo is unavailable, try lzo-rle.
# Keep the active algorithm if no match exists or the write fails.
# SWAP_ALGORITHM=kernel_default

# Swap priority for zram devices (higher = preferred over other swap)
# SWAP_PRIORITY=5

# RAM log uses the swap policy unless overridden. Use auto to probe RAM log algorithms.
# RAMLOG_ALGORITHM=auto

# Compressed /tmp uses the swap policy unless overridden.
# TMP_ALGORITHM=lz4

# Size for zram based /tmp, total memory / 2 by default
# TMP_SIZE=500M

# If defined a separate partition will be used as zram backing device. Be CAREFUL
# which partition you assign and read starting from CONFIG_ZRAM_WRITEBACK in
# https://www.kernel.org/doc/Documentation/blockdev/zram.txt
# ZRAM_BACKING_DEV=/dev/nvme0n2
